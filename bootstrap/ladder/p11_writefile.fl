// EXPECT stdout:1
// EXPECT exit:0
// 生成程序必须能自己写文件：writefile(path, pathlen, data, len)

fn main() -> i64 {
    let path: ^u8 = alloc(64, 8);
    path[0] = 98;   // b
    path[1] = 117;  // u
    path[2] = 105;  // i
    path[3] = 108;  // l
    path[4] = 100;  // d
    path[5] = 92;   // backslash
    path[6] = 112;  // p
    path[7] = 49;   // 1
    path[8] = 49;   // 1
    path[9] = 95;   // _
    path[10] = 119; // w
    path[11] = 102; // f
    path[12] = 46;  // .
    path[13] = 116; // t
    path[14] = 120; // x
    path[15] = 116; // t
    path[16] = 0;

    let data: ^u8 = alloc(16, 8);
    data[0] = 70;   // F
    data[1] = 76;   // L
    data[2] = 73;   // I
    data[3] = 78;   // N
    data[4] = 84;   // T

    let r: i64 = writefile(path, 16, data, 5);
    print(r);
    free(path);
    free(data);
    return 0;
}
