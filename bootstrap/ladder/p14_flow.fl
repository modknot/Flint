// EXPECT stdout:34
// EXPECT exit:0
fn main() -> i64 {
    let sum: i64 = 0;
    for i in 0..3 {
        for j in 0..3 {
            if j == 1 { continue; }
            if j == 2 { break; }
            sum += i * 10 + j;
        }
    }
    let k: i64 = 0;
    let w: i64 = 0;
    while k < 5 {
        k += 1;
        if k == 2 { continue; }
        if k == 4 { break; }
        w += k;
    }
    print(sum + w);
    return 0;
}