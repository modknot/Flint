// EXPECT stdout:7
// EXPECT exit:0
// Minimal parser skeleton: Token heap array -> recursive-descent AST -> recursive evaluation.
struct Node {
    kind: i64,
    val: i64,
    left: ^Node,
    right: ^Node,
}

struct Token {
    kind: u8,
    val: i64,
}

fn new_node(kind: i64, val: i64, left: ^Node, right: ^Node) -> ^Node {
    let n: ^Node = alloc(32, 8);
    n.kind = kind;
    n.val = val;
    n.left = left;
    n.right = right;
    return n;
}

fn parse_primary(toks: ^Token, pos: ^i64) -> ^Node {
    let k: i64 = toks[pos.*].kind as i64;
    if k == 1 {
        let v: i64 = toks[pos.*].val;
        pos.* += 1;
        return new_node(0, v, 0, 0);
    }
    return 0;
}

fn parse_term(toks: ^Token, pos: ^i64) -> ^Node {
    let left: ^Node = parse_primary(toks, pos);
    while (toks[pos.*].kind as i64) == 3 {
        pos.* += 1;
        let right: ^Node = parse_primary(toks, pos);
        left = new_node(2, 0, left, right);
    }
    return left;
}

fn parse_expr(toks: ^Token, pos: ^i64) -> ^Node {
    let left: ^Node = parse_term(toks, pos);
    while (toks[pos.*].kind as i64) == 2 {
        pos.* += 1;
        let right: ^Node = parse_term(toks, pos);
        left = new_node(1, 0, left, right);
    }
    return left;
}

fn eval(n: ^Node) -> i64 {
    let k: i64 = n.kind;
    if k == 0 { return n.val; }
    if k == 1 { return eval(n.left) + eval(n.right); }
    return eval(n.left) * eval(n.right);
}

fn main() -> i64 {
    let toks: ^Token = alloc(80, 8);
    toks[0].kind = 1;
    toks[0].val = 1;
    toks[1].kind = 2;
    toks[1].val = 0;
    toks[2].kind = 1;
    toks[2].val = 2;
    toks[3].kind = 3;
    toks[3].val = 0;
    toks[4].kind = 1;
    toks[4].val = 3;
    let pos: ^i64 = alloc(8, 8);
    pos.* = 0;
    let ast: ^Node = parse_expr(toks, pos);
    let result: i64 = eval(ast);
    print(result);
    free(ast);
    free(pos);
    free(toks);
    return 0;
}
