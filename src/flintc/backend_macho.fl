// ------------------------------ Mach-O 64 后端 ---------------------------
// Layout:
//   0x000 header
//   0x020 LC_SEGMENT_64(__PAGEZERO)
//   0x068 LC_SEGMENT_64(__TEXT) + one __text section
//   0x100 LC_BUILD_VERSION
//   0x118 LC_MAIN
//   0x130 LC_SEGMENT_64(__LINKEDIT)
//   0x200 generated code
//   0x2000 file size
fn backend_macho(b: ^u8, code: ^u8, clen: i64) -> i64 {
    zero_bytes(b, 0x2000);

    put32(b, 0, 0xFEEDFACF); put32(b, 4, 0x01000007); put32(b, 8, 3); put32(b, 12, 2);
    put32(b, 16, 5); put32(b, 20, 0x158); put32(b, 24, 1);

    // __PAGEZERO: 72-byte segment command at 0x20.
    put32(b, 32, 0x19); put32(b, 36, 72);
    put64(b, 64, 0x100000000);

    // __TEXT: 152-byte segment command at 0x68, one section.
    put32(b, 104, 0x19); put32(b, 108, 152);
    put8(b, 112, 95); put8(b, 113, 95); put8(b, 114, 84); put8(b, 115, 69); put8(b, 116, 88); put8(b, 117, 84);
    put64(b, 128, 0x100000000); put64(b, 136, 0x2000);
    put64(b, 144, 0); put64(b, 152, 0x2000);
    put32(b, 160, 7); put32(b, 164, 5); put32(b, 168, 1); put32(b, 172, 0);

    // __text section at 0xB0.
    put8(b, 176, 95); put8(b, 177, 95); put8(b, 178, 116); put8(b, 179, 101); put8(b, 180, 120); put8(b, 181, 116);
    put8(b, 192, 95); put8(b, 193, 95); put8(b, 194, 84); put8(b, 195, 69); put8(b, 196, 88); put8(b, 197, 84);
    put64(b, 208, 0x100000200); put64(b, 216, clen + 9);
    put32(b, 224, 0x200); put32(b, 228, 4);
    put32(b, 240, 0x80000400);

    // LC_BUILD_VERSION at 0x100.
    put32(b, 256, 0x32); put32(b, 260, 24);
    put32(b, 264, 1); put32(b, 268, 0x000A0000); put32(b, 272, 0x000F0000); put32(b, 276, 0);

    // LC_MAIN at 0x118.
    put32(b, 280, 0x80000028); put32(b, 284, 24);
    put64(b, 288, 0x200); put64(b, 296, 0);

    // __LINKEDIT: 72-byte segment command at 0x130, empty until signing.
    put32(b, 304, 0x19); put32(b, 308, 72);
    put8(b, 312, 95); put8(b, 313, 95); put8(b, 314, 76); put8(b, 315, 73); put8(b, 316, 78); put8(b, 317, 75); put8(b, 318, 69); put8(b, 319, 68); put8(b, 320, 73); put8(b, 321, 84);
    put64(b, 328, 0x100002000); put64(b, 336, 0x1000);
    put64(b, 344, 0x2000); put64(b, 352, 0);
    put32(b, 360, 7); put32(b, 364, 1); put32(b, 368, 0); put32(b, 372, 0);

    copy_text(b, 0x200, code, clen);
    let off: i64 = 0x200 + clen;
    put8(b, off, 0x89); put8(b, off + 1, 0xC7);
    put8(b, off + 2, 0xB8); put32(b, off + 3, 0x2000001);
    put8(b, off + 7, 0x0F); put8(b, off + 8, 0x05);
    return 0x2000;
}
