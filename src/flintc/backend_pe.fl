// ------------------------------ PE32+ 后端 ------------------------------
fn backend_pe(b: ^u8, code: ^u8, clen: i64) -> i64 {
    zero_bytes(b, 0x1600);
    put16(b, 0, 0x5A4D); put32(b, 0x3C, 0x40); put32(b, 0x40, 0x00004550);
    put16(b, 0x44, 0x8664); put16(b, 0x46, 1); put16(b, 0x54, 0xF0); put16(b, 0x56, 0x0023);
    put16(b, 0x58, 0x020B); put32(b, 0x5C, 0x1000); put32(b, 0x68, 0x1000); put32(b, 0x6C, 0x1000);
    put64(b, 0x70, 0x140000000); put32(b, 0x78, 0x1000); put32(b, 0x7C, 0x200);
    put16(b, 0x80, 6); put16(b, 0x88, 6); put32(b, 0x90, 0x3000); put32(b, 0x94, 0x200);
    put16(b, 0x9C, 3); put64(b, 0xA0, 0x100000); put64(b, 0xA8, 0x1000);
    put64(b, 0xB0, 0x100000); put64(b, 0xB8, 0x1000); put32(b, 0xC4, 16);
    put32(b, 0xD0, 0x2020); put32(b, 0xD4, 40);
    put8(b, 0x148, 46); put8(b, 0x149, 116); put8(b, 0x14A, 101); put8(b, 0x14B, 120); put8(b, 0x14C, 116);
    put32(b, 0x150, 0x1400); put32(b, 0x154, 0x1000); put32(b, 0x158, 0x1400); put32(b, 0x15C, 0x200);
    put32(b, 0x16C, 0x60000020);

    copy_text(b, 0x200, code, clen);
    let off: i64 = 0x200 + clen;
    put8(b, off, 0x48); put8(b, off + 1, 0x83); put8(b, off + 2, 0xEC); put8(b, off + 3, 0x28);
    put8(b, off + 4, 0x89); put8(b, off + 5, 0xC1);
    put8(b, off + 6, 0xFF); put8(b, off + 7, 0x15); put32(b, off + 8, 0xFF4 - clen);
    put8(b, off + 12, 0x31); put8(b, off + 13, 0xC0);

    put64(b, 0x1200, 0x2010); put64(b, 0x1208, 0);
    put16(b, 0x1210, 0);
    put8(b, 0x1212, 69); put8(b, 0x1213, 120); put8(b, 0x1214, 105); put8(b, 0x1215, 116);
    put8(b, 0x1216, 80); put8(b, 0x1217, 114); put8(b, 0x1218, 111); put8(b, 0x1219, 99);
    put8(b, 0x121A, 101); put8(b, 0x121B, 115); put8(b, 0x121C, 115); put8(b, 0x121D, 0);
    put32(b, 0x122C, 0x2048); put32(b, 0x1230, 0x2000);
    put8(b, 0x1248, 75); put8(b, 0x1249, 69); put8(b, 0x124A, 82); put8(b, 0x124B, 78);
    put8(b, 0x124C, 69); put8(b, 0x124D, 76); put8(b, 0x124E, 51); put8(b, 0x124F, 50);
    put8(b, 0x1250, 46); put8(b, 0x1251, 100); put8(b, 0x1252, 108); put8(b, 0x1253, 108); put8(b, 0x1254, 0);
    return 0x1600;
}

