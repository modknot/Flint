// ------------------------------ PE32+ backend ------------------------------
// Output section layout (file offsets in parentheses):
//   0x0000 runtime; 0x02AD generated-code entry; 0x2F000 (0x2F200) IAT
//   0x2F050 (0x2F250) ILT; 0x2F0B0 (0x2F2B0) import descriptors
//   0x2F130 (0x2F330) DLL name; 0x2F170 (0x2F370) hint/name table
fn backend_pe(b: ^u8, code: ^u8, clen: i64, entry: i64) -> i64 {
    zero_bytes(b, 0x30200);
    put16(b, 0, 0x5A4D); put32(b, 0x3C, 0x40); put32(b, 0x40, 0x00004550);
    put16(b, 0x44, 0x8664); put16(b, 0x46, 1); put16(b, 0x54, 0xF0); put16(b, 0x56, 0x0023);
    put16(b, 0x58, 0x020B); put32(b, 0x5C, 0x30000); put32(b, 0x60, 0x30000); put32(b, 0x64, 0);
    put32(b, 0x68, 0x1000 + entry); put32(b, 0x6C, 0x1000);
    put64(b, 0x70, 0x140000000); put32(b, 0x78, 0x1000); put32(b, 0x7C, 0x200);
    put16(b, 0x80, 6); put16(b, 0x88, 6); put32(b, 0x90, 0x31000); put32(b, 0x94, 0x200);
    put16(b, 0x9C, 3); put64(b, 0xA0, 0x100000); put64(b, 0xA8, 0x1000);
    put64(b, 0xB0, 0x100000); put64(b, 0xB8, 0x1000); put32(b, 0xC4, 16);
    put32(b, 0xD0, 0x300B0); put32(b, 0xD4, 40);
    put8(b, 0x148, 46); put8(b, 0x149, 116); put8(b, 0x14A, 101); put8(b, 0x14B, 120); put8(b, 0x14C, 116);
    put32(b, 0x150, 0x30000); put32(b, 0x154, 0x1000); put32(b, 0x158, 0x30000); put32(b, 0x15C, 0x200);
    put32(b, 0x16C, 0xE0000020);

    copy_text(b, 0x200, code, clen);
    let off: i64 = 0x200 + clen;
    put8(b, off, 0x89); put8(b, off + 1, 0xC1);
    put8(b, off + 2, 0xFF); put8(b, off + 3, 0x15); put32(b, off + 4, 0x2F030 - clen);
    put8(b, off + 8, 0x31); put8(b, off + 9, 0xC0);

    // Each IAT and ILT entry maps one import; both tables end with a zero qword.
    put64(b, 0x2F200, 0x30170);
    put64(b, 0x2F208, 0x30180);
    put64(b, 0x2F210, 0x3018E);
    put64(b, 0x2F218, 0x3019C);
    put64(b, 0x2F220, 0x301A8);
    put64(b, 0x2F228, 0x301B4);
    put64(b, 0x2F230, 0x301C2);
    put64(b, 0x2F238, 0x301D2);
    put64(b, 0x2F240, 0x301E0);
    put64(b, 0x2F248, 0);
    put64(b, 0x2F250, 0x30170);
    put64(b, 0x2F258, 0x30180);
    put64(b, 0x2F260, 0x3018E);
    put64(b, 0x2F268, 0x3019C);
    put64(b, 0x2F270, 0x301A8);
    put64(b, 0x2F278, 0x301B4);
    put64(b, 0x2F280, 0x301C2);
    put64(b, 0x2F288, 0x301D2);
    put64(b, 0x2F290, 0x301E0);
    put64(b, 0x2F298, 0);
    // Import descriptor: OriginalFirstThunk, TimeDateStamp, ForwarderChain, Name, FirstThunk.
    put32(b, 0x2F2B0, 0x30050); put32(b, 0x2F2B4, 0); put32(b, 0x2F2B8, 0);
    put32(b, 0x2F2BC, 0x30130); put32(b, 0x2F2C0, 0x30000);
    // The terminating descriptor is 20 zero bytes, guaranteed by zero_bytes.

    // DLL name.
    put8(b, 0x2F330, 75);
    put8(b, 0x2F331, 69);
    put8(b, 0x2F332, 82);
    put8(b, 0x2F333, 78);
    put8(b, 0x2F334, 69);
    put8(b, 0x2F335, 76);
    put8(b, 0x2F336, 51);
    put8(b, 0x2F337, 50);
    put8(b, 0x2F338, 46);
    put8(b, 0x2F339, 100);
    put8(b, 0x2F33A, 108);
    put8(b, 0x2F33B, 108);
    put8(b, 0x2F33C, 0);

    // hint/name: hint=0, followed by the name and NUL.
    put8(b, 0x2F370, 0); put8(b, 0x2F371, 0);
    put8(b, 0x2F372, 86);
    put8(b, 0x2F373, 105);
    put8(b, 0x2F374, 114);
    put8(b, 0x2F375, 116);
    put8(b, 0x2F376, 117);
    put8(b, 0x2F377, 97);
    put8(b, 0x2F378, 108);
    put8(b, 0x2F379, 65);
    put8(b, 0x2F37A, 108);
    put8(b, 0x2F37B, 108);
    put8(b, 0x2F37C, 111);
    put8(b, 0x2F37D, 99);
    put8(b, 0x2F37E, 0);
    put8(b, 0x2F380, 0); put8(b, 0x2F381, 0);
    put8(b, 0x2F382, 86);
    put8(b, 0x2F383, 105);
    put8(b, 0x2F384, 114);
    put8(b, 0x2F385, 116);
    put8(b, 0x2F386, 117);
    put8(b, 0x2F387, 97);
    put8(b, 0x2F388, 108);
    put8(b, 0x2F389, 70);
    put8(b, 0x2F38A, 114);
    put8(b, 0x2F38B, 101);
    put8(b, 0x2F38C, 101);
    put8(b, 0x2F38D, 0);
    put8(b, 0x2F38E, 0); put8(b, 0x2F38F, 0);
    put8(b, 0x2F390, 67);
    put8(b, 0x2F391, 114);
    put8(b, 0x2F392, 101);
    put8(b, 0x2F393, 97);
    put8(b, 0x2F394, 116);
    put8(b, 0x2F395, 101);
    put8(b, 0x2F396, 70);
    put8(b, 0x2F397, 105);
    put8(b, 0x2F398, 108);
    put8(b, 0x2F399, 101);
    put8(b, 0x2F39A, 65);
    put8(b, 0x2F39B, 0);
    put8(b, 0x2F39C, 0); put8(b, 0x2F39D, 0);
    put8(b, 0x2F39E, 82);
    put8(b, 0x2F39F, 101);
    put8(b, 0x2F3A0, 97);
    put8(b, 0x2F3A1, 100);
    put8(b, 0x2F3A2, 70);
    put8(b, 0x2F3A3, 105);
    put8(b, 0x2F3A4, 108);
    put8(b, 0x2F3A5, 101);
    put8(b, 0x2F3A6, 0);
    put8(b, 0x2F3A8, 0); put8(b, 0x2F3A9, 0);
    put8(b, 0x2F3AA, 87);
    put8(b, 0x2F3AB, 114);
    put8(b, 0x2F3AC, 105);
    put8(b, 0x2F3AD, 116);
    put8(b, 0x2F3AE, 101);
    put8(b, 0x2F3AF, 70);
    put8(b, 0x2F3B0, 105);
    put8(b, 0x2F3B1, 108);
    put8(b, 0x2F3B2, 101);
    put8(b, 0x2F3B3, 0);
    put8(b, 0x2F3B4, 0); put8(b, 0x2F3B5, 0);
    put8(b, 0x2F3B6, 67);
    put8(b, 0x2F3B7, 108);
    put8(b, 0x2F3B8, 111);
    put8(b, 0x2F3B9, 115);
    put8(b, 0x2F3BA, 101);
    put8(b, 0x2F3BB, 72);
    put8(b, 0x2F3BC, 97);
    put8(b, 0x2F3BD, 110);
    put8(b, 0x2F3BE, 100);
    put8(b, 0x2F3BF, 108);
    put8(b, 0x2F3C0, 101);
    put8(b, 0x2F3C1, 0);
    put8(b, 0x2F3C2, 0); put8(b, 0x2F3C3, 0);
    put8(b, 0x2F3C4, 71);
    put8(b, 0x2F3C5, 101);
    put8(b, 0x2F3C6, 116);
    put8(b, 0x2F3C7, 83);
    put8(b, 0x2F3C8, 116);
    put8(b, 0x2F3C9, 100);
    put8(b, 0x2F3CA, 72);
    put8(b, 0x2F3CB, 97);
    put8(b, 0x2F3CC, 110);
    put8(b, 0x2F3CD, 100);
    put8(b, 0x2F3CE, 108);
    put8(b, 0x2F3CF, 101);
    put8(b, 0x2F3D0, 0);
    put8(b, 0x2F3D2, 0); put8(b, 0x2F3D3, 0);
    put8(b, 0x2F3D4, 69);
    put8(b, 0x2F3D5, 120);
    put8(b, 0x2F3D6, 105);
    put8(b, 0x2F3D7, 116);
    put8(b, 0x2F3D8, 80);
    put8(b, 0x2F3D9, 114);
    put8(b, 0x2F3DA, 111);
    put8(b, 0x2F3DB, 99);
    put8(b, 0x2F3DC, 101);
    put8(b, 0x2F3DD, 115);
    put8(b, 0x2F3DE, 115);
    put8(b, 0x2F3DF, 0);
    put8(b, 0x2F3E0, 0); put8(b, 0x2F3E1, 0);
    put8(b, 0x2F3E2, 71);
    put8(b, 0x2F3E3, 101);
    put8(b, 0x2F3E4, 116);
    put8(b, 0x2F3E5, 67);
    put8(b, 0x2F3E6, 111);
    put8(b, 0x2F3E7, 109);
    put8(b, 0x2F3E8, 109);
    put8(b, 0x2F3E9, 97);
    put8(b, 0x2F3EA, 110);
    put8(b, 0x2F3EB, 100);
    put8(b, 0x2F3EC, 76);
    put8(b, 0x2F3ED, 105);
    put8(b, 0x2F3EE, 110);
    put8(b, 0x2F3EF, 101);
    put8(b, 0x2F3F0, 65);
    put8(b, 0x2F3F1, 0);

    return 0x30200;
}
