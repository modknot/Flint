fn new_node(kind: i64, val: i64) -> ^Node {
    let n: ^Node = alloc(64, 8);
    n.kind = kind; n.val = val; n.start = 0; n.len = 0;
    n.left = 0; n.right = 0; n.body = 0; n.next = 0;
    return n;
}

fn peek(c: ^Ctx) -> i64 { return c.toks[c.pos.*].kind; }

fn advance(c: ^Ctx) { c.pos.* += 1; }

fn expect(c: ^Ctx, k: i64) {
    if peek(c) == k { advance(c); } else { advance(c); }
}

fn local_put(c: ^Ctx, tok: i64, off: i64, ty: i64) {
    let i: i64 = c.ln.*;
    c.locals[i].start = c.toks[tok].start;
    c.locals[i].len = c.toks[tok].len;
    c.locals[i].off = off;
    c.locals[i].ty = ty;
    c.ln.* = i + 1;
}

fn local_add(c: ^Ctx, tok: i64, ty: i64) {
    let sz: i64 = type_size(c, ty);
    let sz8: i64 = sz;
    if sz8 < 8 { sz8 = 8; }
    sz8 = (sz8 + 7) / 8 * 8;
    let off: i64 = 0 - c.loff.* - sz8;
    local_put(c, tok, off, ty);
    c.loff.* += sz8;
}

fn param_add(c: ^Ctx, tok: i64, idx: i64, ty: i64) {
    local_put(c, tok, 16 + idx * 8, ty);
}

fn same_name(c: ^Ctx, a: i64, b: i64) -> i64 {
    if c.toks[a].len != c.toks[b].len { return 0; }
    let j: i64 = 0;
    while j < c.toks[a].len {
        if c.src[c.toks[a].start + j] as i64 != c.src[c.toks[b].start + j] as i64 { return 0; }
        j += 1;
    }
    return 1;
}

fn type_is_u8(c: ^Ctx, tok: i64) -> i64 {
    if c.toks[tok].len != 2 { return 0; }
    if c.src[c.toks[tok].start] as i64 != 117 { return 0; }
    if c.src[c.toks[tok].start + 1] as i64 != 56 { return 0; }
    return 1;
}

fn type_is_i64(c: ^Ctx, tok: i64) -> i64 {
    if c.toks[tok].len != 3 { return 0; }
    if c.src[c.toks[tok].start] as i64 != 105 { return 0; }
    if c.src[c.toks[tok].start + 1] as i64 != 54 { return 0; }
    if c.src[c.toks[tok].start + 2] as i64 != 52 { return 0; }
    return 1;
}

fn struct_add(c: ^Ctx, tok: i64, size: i64, first: i64) -> i64 {
    let i: i64 = c.sc.*;
    c.structs[i].start = c.toks[tok].start;
    c.structs[i].len = c.toks[tok].len;
    c.structs[i].size = size;
    c.structs[i].first = first;
    c.sc.* = i + 1;
    return i + 1;
}

fn field_add(c: ^Ctx, tok: i64, off: i64, ty: i64) {
    let i: i64 = c.fcn.*;
    c.fields[i].start = c.toks[tok].start;
    c.fields[i].len = c.toks[tok].len;
    c.fields[i].off = off;
    c.fields[i].ty = ty;
    c.fcn.* = i + 1;
}

fn struct_find(c: ^Ctx, tok: i64) -> i64 {
    let i: i64 = 0;
    while i < c.sc.* {
        if c.structs[i].len == c.toks[tok].len {
            let j: i64 = 0;
            let ok: i64 = 1;
            while j < c.structs[i].len {
                if c.src[c.structs[i].start + j] as i64 != c.src[c.toks[tok].start + j] as i64 { ok = 0; }
                j += 1;
            }
            if ok == 1 { return i + 1; }
        }
        i += 1;
    }
    return 0;
}

fn field_find(c: ^Ctx, sid: i64, tok: i64) -> i64 {
    let i: i64 = 0;
    while i < c.structs[sid - 1].size / 8 {
        let f: ^Field = c.fields;
        let fi: i64 = c.structs[sid - 1].first + i;
        if f[fi].len == c.toks[tok].len {
            let j: i64 = 0;
            let ok: i64 = 1;
            while j < f[fi].len {
                if c.src[f[fi].start + j] as i64 != c.src[c.toks[tok].start + j] as i64 { ok = 0; }
                j += 1;
            }
            if ok == 1 { return fi; }
        }
        i += 1;
    }
    return -1;
}

fn struct_of_type(ty: i64) -> i64 {
    if ty >= 0x200 { return ty - 0x200; }
    if ty >= 0x100 { return ty - 0x100; }
    return 0;
}

fn pointee_type(ty: i64) -> i64 {
    if ty == 2 { return 1; }
    if ty == 3 { return 0; }
    if ty >= 0x100 { return ty - 0x100 + 0x200; }
    return 0;
}

fn type_size(c: ^Ctx, ty: i64) -> i64 {
    if ty == 1 { return 1; }
    if ty == 4 { return 8; }
    if ty >= 0x400 { return c.arrs[ty - 0x400].size; }
    if ty >= 0x200 { return c.structs[ty - 0x200 - 1].size; }
    return 8;
}

fn elem_size(c: ^Ctx, ty: i64) -> i64 {
    if ty >= 0x400 { return type_size(c, array_elem_type(c, ty)); }
    return type_size(c, pointee_type(ty));
}

fn array_add(c: ^Ctx, elem: i64, count: i64) -> i64 {
    let i: i64 = c.ac.*;
    c.arrs[i].elem = elem;
    c.arrs[i].count = count;
    c.arrs[i].size = type_size(c, elem) * count;
    c.ac.* = i + 1;
    return 0x400 + i;
}

fn is_array(ty: i64) -> i64 {
    if ty >= 0x400 { return 1; }
    return 0;
}

fn array_elem(ty: i64) -> i64 {
    if ty >= 0x400 { return ty; }
    return 0;
}

fn array_elem_type(c: ^Ctx, ty: i64) -> i64 {
    return c.arrs[ty - 0x400].elem;
}

fn array_count(c: ^Ctx, ty: i64) -> i64 {
    return c.arrs[ty - 0x400].count;
}

fn parse_type(c: ^Ctx) -> i64 {
    if peek(c) == 31 {
        advance(c);
        let elem: i64 = parse_type(c);
        expect(c, 15);
        let count: i64 = 0;
        if peek(c) == 2 { count = c.toks[c.pos.*].val; advance(c); }
        expect(c, 32);
        return array_add(c, elem, count);
    }
    if peek(c) == 3 {
        advance(c);
        if peek(c) == 1 {
            let conv: i64 = c.pos.*;
            if c.toks[conv].len == 1 { advance(c); }
            if c.toks[conv].len == 4 { advance(c); }
            if c.toks[conv].len == 5 { advance(c); }
        }
        expect(c, 9);
        while peek(c) != 10 {
            if peek(c) == 0 { advance(c); }
            else {
                parse_type(c);
                if peek(c) == 13 { advance(c); }
            }
        }
        expect(c, 10);
        if peek(c) == 16 { advance(c); parse_type(c); }
        return 4;
    }
    let ptr: i64 = 0;
    if peek(c) == 30 { advance(c); ptr = 1; }
    let tok: i64 = c.pos.*;
    advance(c);
    let ty: i64 = 0;
    if type_is_u8(c, tok) == 1 { ty = 1; }
    else {
        if type_is_byte(c, tok) == 1 { ty = 1; }
        else {
            if type_is_i64(c, tok) == 1 { ty = 0; }
            else {
                let sid: i64 = struct_find(c, tok);
                if sid > 0 { ty = 0x200 + sid; }
            }
        }
    }
    if ptr == 1 {
        if ty == 1 { return 2; }
        if ty == 0 { return 3; }
        if ty >= 0x200 { return ty - 0x200 + 0x100; }
    }
    return ty;
}

fn is_main_name(c: ^Ctx, tok: i64) -> i64 {
    if c.toks[tok].len != 4 { return 0; }
    let s: i64 = c.toks[tok].start;
    if c.src[s] as i64 == 109 { if c.src[s + 1] as i64 == 97 { if c.src[s + 2] as i64 == 105 { if c.src[s + 3] as i64 == 110 { return 1; } } } }
    return 0;
}

fn find_main(c: ^Ctx, prog: ^Node) -> i64 {
    let f: ^Node = prog;
    let cnt: i64 = 0;
    while f != 0 {
        if f.kind == 91 {
            cnt += 1;
            if is_main_name(c, f.val) == 1 { return f.val; }
        }
        f = f.next;
    }
    return -1;
}

fn func_add(c: ^Ctx, tok: i64, label: i64, arity: i64) {
    let i: i64 = c.fc.*;
    c.funcs[i].start = c.toks[tok].start;
    c.funcs[i].len = c.toks[tok].len;
    c.funcs[i].label = label;
    c.funcs[i].arity = arity;
    c.funcs[i].ret = 0;
    c.fc.* = i + 1;
}

fn func_find(c: ^Ctx, tok: i64) -> i64 {
    let i: i64 = 0;
    while i < c.fc.* {
        if c.funcs[i].len == c.toks[tok].len {
            let j: i64 = 0;
            let ok: i64 = 1;
            while j < c.funcs[i].len {
                if c.src[c.funcs[i].start + j] as i64 != c.src[c.toks[tok].start + j] as i64 { ok = 0; }
                j += 1;
            }
            if ok == 1 { return c.funcs[i].label; }
        }
        i += 1;
    }
    return 0;
}

fn call_add(c: ^Ctx, disp: i64, name: i64) {
    let i: i64 = c.cn.*;
    c.calls[i].disp = disp;
    c.calls[i].name = name;
    c.cn.* = i + 1;
}

fn param_count(p: ^Node) -> i64 {
    let n: ^Node = p;
    let k: i64 = 0;
    while n != 0 { k += 1; n = n.next; }
    return k;
}

fn local_find(c: ^Ctx, tok: i64) -> i64 {
    let i: i64 = 0;
    while i < c.ln.* {
        if c.locals[i].len == c.toks[tok].len {
            let j: i64 = 0;
            let ok: i64 = 1;
            while j < c.locals[i].len {
                if c.src[c.locals[i].start + j] as i64 != c.src[c.toks[tok].start + j] as i64 { ok = 0; }
                j += 1;
            }
            if ok == 1 { return c.locals[i].off; }
        }
        i += 1;
    }
    return 0;
}

fn local_type(c: ^Ctx, tok: i64) -> i64 {
    let i: i64 = 0;
    while i < c.ln.* {
        if c.locals[i].len == c.toks[tok].len {
            let j: i64 = 0;
            let ok: i64 = 1;
            while j < c.locals[i].len {
                if c.src[c.locals[i].start + j] as i64 != c.src[c.toks[tok].start + j] as i64 { ok = 0; }
                j += 1;
            }
            if ok == 1 { return c.locals[i].ty; }
        }
        i += 1;
    }
    return 0;
}

fn func_ret(c: ^Ctx, tok: i64) -> i64 {
    let i: i64 = 0;
    while i < c.fc.* {
        if c.funcs[i].len == c.toks[tok].len {
            let j: i64 = 0;
            let ok: i64 = 1;
            while j < c.funcs[i].len {
                if c.src[c.funcs[i].start + j] as i64 != c.src[c.toks[tok].start + j] as i64 { ok = 0; }
                j += 1;
            }
            if ok == 1 { return c.funcs[i].ret; }
        }
        i += 1;
    }
    return 0;
}

fn parse_struct_lit(c: ^Ctx) -> ^Node {
    let name: i64 = c.pos.*;
    advance(c);
    expect(c, 11);
    let fhead: ^Node = 0;
    let ftail: ^Node = 0;
    while peek(c) != 12 {
        if peek(c) == 0 { advance(c); }
        else {
            if peek(c) == 1 {
                let ftok: i64 = c.pos.*;
                advance(c);
                expect(c, 14);
                let fval: ^Node = parse_cmp(c);
                let fnode: ^Node = new_node(82, ftok);
                fnode.left = fval;
                if fhead == 0 { fhead = fnode; ftail = fnode; }
                else { ftail.next = fnode; ftail = fnode; }
                if peek(c) == 13 { advance(c); }
            } else { advance(c); }
        }
    }
    expect(c, 12);
    let sid: i64 = struct_find(c, name);
    let n: ^Node = new_node(81, 0x200 + sid);
    n.left = fhead;
    return n;
}

fn parse_array_lit(c: ^Ctx) -> ^Node {
    advance(c);
    let head: ^Node = 0;
    let tail: ^Node = 0;
    while peek(c) != 32 {
        if peek(c) == 0 { advance(c); }
        else {
            let e: ^Node = parse_cmp(c);
            if head == 0 { head = e; tail = e; }
            else { tail.next = e; tail = e; }
            if peek(c) == 13 { advance(c); }
        }
    }
    expect(c, 32);
    let n: ^Node = new_node(80, 0);
    n.left = head;
    return n;
}

fn parse_atom(c: ^Ctx) -> ^Node {
    if peek(c) == 31 {
        return parse_array_lit(c);
    }
    if peek(c) == 43 {
        let idx_ch: i64 = c.pos.*;
        let node_ch: ^Node = new_node(12, c.toks[idx_ch].val);
        advance(c);
        return node_ch;
    }
    if peek(c) == 2 {
        let idx_i: i64 = c.pos.*;
        let node_i: ^Node = new_node(12, c.toks[idx_i].val);
        advance(c);
        return node_i;
    }
    if peek(c) == 1 {
        let idx_fn: i64 = c.pos.*;
        if c.toks[idx_fn + 1].kind == 11 {
            let sid_lit: i64 = struct_find(c, idx_fn);
            if sid_lit > 0 { return parse_struct_lit(c); }
        }
        if c.toks[idx_fn + 1].kind == 9 {
            advance(c);
            advance(c);
            let args: ^Node = 0;
            let tail_args: ^Node = 0;
            while peek(c) != 10 {
                if peek(c) == 0 { advance(c); }
                else {
                    let a: ^Node = parse_cmp(c);
                    if args == 0 { args = a; tail_args = a; }
                    else { tail_args.next = a; tail_args = a; }
                    if peek(c) == 13 { advance(c); }
                }
            }
            if peek(c) == 10 { advance(c); }
            let node_call: ^Node = new_node(14, idx_fn);
            node_call.left = args;
            return node_call;
        }
        let idx_id: i64 = c.pos.*;
        let node_id: ^Node = new_node(13, idx_id);
        advance(c);
        return node_id;
    }
    if peek(c) == 9 {
        advance(c);
        let expr_p: ^Node = parse_expr(c);
        expect(c, 10);
        return expr_p;
    }
    if peek(c) == 18 {
        advance(c);
        let node_neg: ^Node = new_node(11, 0);
        node_neg.left = parse_primary(c);
        return node_neg;
    }
    let node_zero: ^Node = new_node(12, 0);
    advance(c);
    return node_zero;
}

fn parse_postfix(c: ^Ctx) -> ^Node {
    let e: ^Node = parse_atom(c);
    let go: i64 = 1;
    while go == 1 {
        if peek(c) == 31 {
            advance(c);
            let idx: ^Node = parse_cmp(c);
            expect(c, 32);
            let node_ix: ^Node = new_node(16, 0);
            node_ix.left = e; node_ix.right = idx;
            e = node_ix;
        } else {
            if peek(c) == 37 {
                advance(c);
                let node_dr: ^Node = new_node(18, 0);
                node_dr.left = e;
                e = node_dr;
            } else {
                if peek(c) == 36 {
                    advance(c);
                    let ft: i64 = c.pos.*;
                    advance(c);
                    let node_fd: ^Node = new_node(19, ft);
                    node_fd.left = e;
                    e = node_fd;
                } else {
                    if peek(c) == 39 {
                        advance(c);
                        let ty: i64 = parse_type(c);
                        let node_cs: ^Node = new_node(17, ty);
                        node_cs.left = e;
                        e = node_cs;
                    } else { go = 0; }
                }
            }
        }
    }
    return e;
}

fn parse_primary(c: ^Ctx) -> ^Node {
    return parse_postfix(c);
}

fn parse_term(c: ^Ctx) -> ^Node {
    let left_t: ^Node = parse_primary(c);
    let go_t: i64 = 1;
    while go_t == 1 {
        let kt: i64 = peek(c);
        if kt == 19 { advance(c); let r1: ^Node = parse_primary(c); let n1: ^Node = new_node(10, 19); n1.left = left_t; n1.right = r1; left_t = n1; }
        else {
            if kt == 20 { advance(c); let r2: ^Node = parse_primary(c); let n2: ^Node = new_node(10, 20); n2.left = left_t; n2.right = r2; left_t = n2; }
            else {
                if kt == 21 { advance(c); let r3: ^Node = parse_primary(c); let n3: ^Node = new_node(10, 21); n3.left = left_t; n3.right = r3; left_t = n3; }
                else { go_t = 0; }
            }
        }
    }
    return left_t;
}

fn parse_expr(c: ^Ctx) -> ^Node {
    let left_e: ^Node = parse_term(c);
    let go_e: i64 = 1;
    while go_e == 1 {
        let ke: i64 = peek(c);
        if ke == 17 { advance(c); let ra: ^Node = parse_term(c); let na: ^Node = new_node(10, 17); na.left = left_e; na.right = ra; left_e = na; }
        else {
            if ke == 18 { advance(c); let rs: ^Node = parse_term(c); let ns: ^Node = new_node(10, 18); ns.left = left_e; ns.right = rs; left_e = ns; }
            else { go_e = 0; }
        }
    }
    return left_e;
}

fn cmp_node(c: ^Ctx, left: ^Node, op: i64) -> ^Node {
    advance(c);
    let right_cmp: ^Node = parse_expr(c);
    let node_cmp: ^Node = new_node(10, op);
    node_cmp.left = left;
    node_cmp.right = right_cmp;
    return node_cmp;
}

fn parse_cmp(c: ^Ctx) -> ^Node {
    let left_c: ^Node = parse_expr(c);
    let kc: i64 = peek(c);
    if kc == 23 { left_c = cmp_node(c, left_c, 23); }
    if kc == 24 { left_c = cmp_node(c, left_c, 24); }
    if kc == 25 { left_c = cmp_node(c, left_c, 25); }
    if kc == 26 { left_c = cmp_node(c, left_c, 26); }
    if kc == 27 { left_c = cmp_node(c, left_c, 27); }
    if kc == 28 { left_c = cmp_node(c, left_c, 28); }
    return left_c;
}

fn expr_type(c: ^Ctx, n: ^Node) -> i64 {
    if n == 0 { return 0; }
    let k: i64 = n.kind;
    if k == 13 { return local_type(c, n.val); }
    if k == 16 {
        let lt: i64 = expr_type(c, n.left);
        if is_array(lt) == 1 { return array_elem_type(c, lt); }
        return pointee_type(lt);
    }
    if k == 80 { return n.val; }
    if k == 81 { return n.val; }
    if k == 17 { return n.val; }
    if k == 18 { return pointee_type(expr_type(c, n.left)); }
    if k == 19 {
        let sid: i64 = struct_of_type(expr_type(c, n.left));
        if sid > 0 {
            let fi: i64 = field_find(c, sid, n.val);
            if fi >= 0 { return c.fields[fi].ty; }
        }
        return 0;
    }
    if k == 14 { return func_ret(c, n.val); }
    return 0;
}

fn parse_stmt(c: ^Ctx) -> ^Node {
    if peek(c) == 47 {
        advance(c);
        expect(c, 15);
        return new_node(101, 0);
    }
    if peek(c) == 48 {
        advance(c);
        expect(c, 15);
        return new_node(102, 0);
    }
    if peek(c) == 44 {
        advance(c);
        let name_for: i64 = c.pos.*;
        advance(c);
        expect(c, 45);
        let start_for: ^Node = parse_cmp(c);
        expect(c, 46);
        let end_for: ^Node = parse_cmp(c);
        let body_for: ^Node = parse_block(c);
        let n_for: ^Node = new_node(100, name_for);
        n_for.start = 0;
        n_for.left = start_for;
        n_for.right = end_for;
        n_for.body = body_for;
        if peek(c) == 15 { advance(c); }
        return n_for;
    }
    let n: ^Node = 0;
    if peek(c) == 4 {
        advance(c);
        let name_let: i64 = c.pos.*;
        advance(c);
        let ty_let: i64 = 0;
        if peek(c) == 14 { advance(c); ty_let = parse_type(c); }
        expect(c, 22);
        let expr_let: ^Node = parse_cmp(c);
        n = new_node(93, name_let);
        n.start = ty_let;
        n.left = expr_let;
    } else {
        if peek(c) == 5 {
            advance(c);
            n = new_node(94, 0);
            if peek(c) != 15 { if peek(c) != 12 { n.left = parse_cmp(c); } }
        } else {
            if peek(c) == 6 {
                advance(c);
                let cond_if: ^Node = parse_cmp(c);
                let body_if: ^Node = parse_block(c);
                n = new_node(95, 0); n.left = cond_if; n.body = body_if;
                if peek(c) == 7 { advance(c); if peek(c) == 6 { n.right = parse_stmt(c); } else { n.right = parse_block(c); } }
            } else {
                if peek(c) == 8 {
                    advance(c);
                    let cond_wh: ^Node = parse_cmp(c);
                    let body_wh: ^Node = parse_block(c);
                    n = new_node(96, 0); n.left = cond_wh; n.body = body_wh;
                } else {
                    if peek(c) == 11 {
                        n = parse_block(c);
                    } else {
                        if peek(c) == 15 { advance(c); }
                        else {
                            if peek(c) != 12 {
                                if peek(c) != 0 {
                                    let lhs: ^Node = parse_cmp(c);
                                    if peek(c) == 22 {
                                        advance(c);
                                        n = new_node(97, 0);
                                        n.left = lhs;
                                        n.right = parse_cmp(c);
                                    } else {
                                        if peek(c) == 40 {
                                            advance(c);
                                            n = new_node(99, 17);
                                            n.left = lhs;
                                            n.right = parse_cmp(c);
                                        } else {
                                            n = new_node(98, 0);
                                            n.left = lhs;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if peek(c) == 15 { advance(c); }
    return n;
}

fn parse_block(c: ^Ctx) -> ^Node {
    expect(c, 11);
    let head: ^Node = 0;
    let tail: ^Node = 0;
    let go: i64 = 1;
    while go == 1 {
        if peek(c) == 0 { go = 0; }
        else {
            if peek(c) == 12 { go = 0; }
            else {
                let s: ^Node = parse_stmt(c);
                if s != 0 {
                    if head == 0 { head = s; tail = s; }
                    else { tail.next = s; tail = s; }
                }
            }
        }
    }
    expect(c, 12);
    return head;
}

fn parse_fn(c: ^Ctx) -> ^Node {
    expect(c, 3);
    let name: i64 = c.pos.*;
    advance(c);
    expect(c, 9);
    let phead: ^Node = 0;
    let ptail: ^Node = 0;
    while peek(c) != 10 {
        if peek(c) == 0 { advance(c); }
        else {
            if peek(c) == 1 {
                let ptok: i64 = c.pos.*;
                advance(c);
                let pty: i64 = 0;
                if peek(c) == 14 { advance(c); pty = parse_type(c); }
                let pnode: ^Node = new_node(92, ptok);
                pnode.start = pty;
                if phead == 0 { phead = pnode; ptail = pnode; }
                else { ptail.next = pnode; ptail = pnode; }
                if peek(c) == 13 { advance(c); }
            } else { advance(c); }
        }
    }
    if peek(c) == 10 { advance(c); }
    let ret: i64 = 0;
    if peek(c) == 16 { advance(c); ret = parse_type(c); }
    let body: ^Node = parse_block(c);
    let n: ^Node = new_node(91, name);
    n.start = ret;
    n.left = phead;
    n.body = body;
    return n;
}

fn parse_struct(c: ^Ctx) -> ^Node {
    expect(c, 38);
    let name: i64 = c.pos.*;
    advance(c);
    expect(c, 11);
    let fhead: ^Node = 0;
    let ftail: ^Node = 0;
    let off: i64 = 0;
    let first: i64 = c.fcn.*;
    while peek(c) != 12 {
        if peek(c) == 0 { advance(c); }
        else {
            if peek(c) == 1 {
                let ftok: i64 = c.pos.*;
                advance(c);
                expect(c, 14);
                let fty: i64 = parse_type(c);
                field_add(c, ftok, off, fty);
                let fnode: ^Node = new_node(89, ftok);
                fnode.start = off;
                fnode.len = fty;
                if fhead == 0 { fhead = fnode; ftail = fnode; }
                else { ftail.next = fnode; ftail = fnode; }
                off += 8;
                if peek(c) == 13 { advance(c); }
            } else { advance(c); }
        }
    }
    expect(c, 12);
    let sid: i64 = struct_add(c, name, off, first);
    let n: ^Node = new_node(90, name);
    n.start = off;
    n.len = sid;
    n.body = fhead;
    return n;
}

fn parse_program(c: ^Ctx) -> ^Node {
    let head: ^Node = 0;
    let tail: ^Node = 0;
    while peek(c) != 0 {
        let f: ^Node = 0;
        if peek(c) == 38 { f = parse_struct(c); }
        else { f = parse_fn(c); }
        if head == 0 { head = f; tail = f; }
        else { tail.next = f; tail = f; }
    }
    return head;
}

