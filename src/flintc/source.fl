// ---------------------- source module loader ----------------------
// The compiler expands // include: itself; it does not depend on the
// PowerShell preprocessor. Paths are relative to the including file; the
// recursion limit is 16.

struct Loader {
    path: ^u8,
    plen: i64,
    dst: ^u8,
    cap: i64,
}

fn is_line_space(b: i64) -> i64 {
    if b == 32 { return 1; }
    if b == 9 { return 1; }
    return 0;
}

fn path_sep(b: i64) -> i64 {
    if b == 47 { return 1; }
    if b == 92 { return 1; }
    return 0;
}

fn path_dir_len(p: ^u8, n: i64) -> i64 {
    let i: i64 = n;
    while i > 0 {
        if path_sep(p[i - 1] as i64) == 1 { return i; }
        i = i - 1;
    }
    return 0;
}

fn line_end(src: ^u8, n: i64, start: i64) -> i64 {
    let i: i64 = start;
    while i < n {
        if src[i] as i64 == 10 { return i; }
        if src[i] as i64 == 13 { return i; }
        i += 1;
    }
    return n;
}

fn trim_line_end(src: ^u8, start: i64, end: i64) -> i64 {
    let i: i64 = end;
    let go: i64 = 1;
    while go == 1 {
        if i > start {
            if is_line_space(src[i - 1] as i64) == 1 { i = i - 1; } else { go = 0; }
        } else { go = 0; }
    }
    return i;
}

// Returns the start index of the include file name; returns -1 when the line
// is not an include directive.
fn include_name_at(src: ^u8, n: i64, line: i64) -> i64 {
    if line > 0 {
        if src[line - 1] as i64 != 10 {
            if src[line - 1] as i64 != 13 { return 0 - 1; }
        }
    }

    let i: i64 = line;
    let go: i64 = 1;
    while go == 1 {
        if i < n {
            if is_line_space(src[i] as i64) == 1 { i += 1; } else { go = 0; }
        } else { go = 0; }
    }

    if i + 2 > n { return 0 - 1; }
    if src[i] as i64 != 47 { return 0 - 1; }
    if src[i + 1] as i64 != 47 { return 0 - 1; }
    i += 2;

    let go2: i64 = 1;
    while go2 == 1 {
        if i < n {
            if is_line_space(src[i] as i64) == 1 { i += 1; } else { go2 = 0; }
        } else { go2 = 0; }
    }

    if i + 8 > n { return 0 - 1; }
    if src[i] as i64 != 105 { return 0 - 1; }
    if src[i + 1] as i64 != 110 { return 0 - 1; }
    if src[i + 2] as i64 != 99 { return 0 - 1; }
    if src[i + 3] as i64 != 108 { return 0 - 1; }
    if src[i + 4] as i64 != 117 { return 0 - 1; }
    if src[i + 5] as i64 != 100 { return 0 - 1; }
    if src[i + 6] as i64 != 101 { return 0 - 1; }
    if src[i + 7] as i64 != 58 { return 0 - 1; }
    i += 8;

    let go3: i64 = 1;
    while go3 == 1 {
        if i < n {
            if is_line_space(src[i] as i64) == 1 { i += 1; } else { go3 = 0; }
        } else { go3 = 0; }
    }

    if i >= n { return 0 - 1; }
    if src[i] as i64 == 10 { return 0 - 1; }
    if src[i] as i64 == 13 { return 0 - 1; }
    return i;
}

fn expand_into(ld: ^Loader, base: i64, depth: i64) -> i64 {
    if depth > 16 { return 0; }

    let path: ^u8 = ld.path;
    let plen: i64 = ld.plen;
    let dst: ^u8 = ld.dst;
    let cap: i64 = ld.cap;

    let fb: ^u8 = alloc(0x40000, 8);
    let n: i64 = readfile(path, plen, fb, 0x40000);
    if n <= 0 { free(fb); return 0; }

    let out: i64 = 0;
    let i: i64 = 0;
    let dirn: i64 = path_dir_len(path, plen);

    while i < n {
        let ns: i64 = include_name_at(fb, n, i);
        if ns >= 0 {
            let ne: i64 = line_end(fb, n, ns);
            let ntrim: i64 = trim_line_end(fb, ns, ne);
            let nl: i64 = ntrim - ns;
            let ip: ^u8 = alloc(512, 8);
            let k: i64 = 0;
            while k < dirn { ip[k] = path[k]; k += 1; }
            k = 0;
            while k < nl { ip[dirn + k] = fb[ns + k]; k += 1; }
            ip[dirn + nl] = 0;

            let child_ld: ^Loader = alloc(64, 8);
            child_ld.path = ip;
            child_ld.plen = dirn + nl;
            child_ld.dst = dst;
            child_ld.cap = cap - out;
            let child: i64 = expand_into(child_ld, base + out, depth + 1);
            free(child_ld);
            free(ip);
            if child == 0 { free(fb); return 0; }
            out += child;

            i = ne;
            if i < n {
                if fb[i] as i64 == 13 { i += 1; }
            }
            if i < n {
                if fb[i] as i64 == 10 { i += 1; }
            }
        } else {
            if out >= cap { free(fb); return 0; }
            dst[base + out] = fb[i];
            out += 1;
            i += 1;
        }
    }

    free(fb);
    return out;
}

fn expand_source(path: ^u8, plen: i64, dst: ^u8, cap: i64) -> i64 {
    let ld: ^Loader = alloc(64, 8);
    ld.path = path;
    ld.plen = plen;
    ld.dst = dst;
    ld.cap = cap;
    let n: i64 = expand_into(ld, 0, 0);
    free(ld);
    return n;
}
