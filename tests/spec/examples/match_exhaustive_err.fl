// SPEC-EXAMPLE match_exhaustive_err
// Expect: compile error E4022 (missing Color::Blue), diagnostics list the missing pattern
enum Color { Red, Green, Blue }

fn f(c: Color) -> i64 {
    match c {
        Color::Red => 1,
        Color::Green => 2,
    }
}

fn main() -> i64 { return f(Color::Red); }
