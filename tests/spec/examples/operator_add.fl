// SPEC-EXAMPLE operator_add
// Expect: 4 (operator + accepts only a fixed set; precedence cannot change)
struct Vec2 { x: i64, y: i64 }

impl Vec2 {
    operator + (a: Vec2, b: Vec2) -> Vec2 {
        return Vec2{ x: a.x + b.x, y: a.y + b.y };
    }
}

fn main() -> i64 {
    let v: Vec2 = Vec2{ x: 1, y: 2 } + Vec2{ x: 3, y: 4 };
    print(v.x);
    return 0;
}
